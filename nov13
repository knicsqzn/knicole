# 10. MAIN GAME
# ==========================================

def main():

    pygame.init()

    screen = pygame.display.set_mode((WIDTH, HEIGHT))

    pygame.display.set_caption(
        "Temple Run: Python Programming Academic Run"
    )

    while True:

        selected_level = welcome_menu(screen)

        while True:

            success, final_score = play_level(
                selected_level, screen
            )

            total_questions = len(QUESTIONS[selected_level])

            if success:

                result = end_menu(
                    screen,
                    selected_level,
                    final_score,
                    total_questions,
                    True
                )

            else:

                result = end_menu(
                    screen,
                    selected_level,
                    final_score,
                    total_questions,
                    False
                )

            if result == "retry":
                continue

            elif result == "menu":
                break


# ==========================================
# 11. START GAME
# ==========================================

if __name__ == "__main__":
    main()

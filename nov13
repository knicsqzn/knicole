            ("3. FINAL - Loops and Iterations", "Final"),
            ("4. EXIT GAME", "Exit")
        ]

        buttons = []

        for i, option in enumerate(options):

            button = draw_button(
                screen, option[0],
                200, 370 + i * 75,
                600, 55, mouse_pos
            )

            buttons.append((button, option[1]))

        draw_text(
            screen, "Press 1, 2, 3, or 4 to select",
            subtitle_font, YELLOW, WIDTH // 2, 710, True
        )

        for event in pygame.event.get():

            if event.type == pygame.QUIT:
                pygame.quit()
                sys.exit()

            if event.type == pygame.KEYDOWN:

                if event.key == pygame.K_1:
                    return "Prelim"

                elif event.key == pygame.K_2:
                    return "Midterm"

                elif event.key == pygame.K_3:
                    return "Final"

                elif event.key == pygame.K_4:
                    pygame.quit()
                    sys.exit()

            if event.type == pygame.MOUSEBUTTONDOWN:

                if event.button == 1:

                    for button, choice in buttons:

                        if button.collidepoint(event.pos):

                            if choice == "Exit":
                                pygame.quit()
                                sys.exit()

                            return choice

        pygame.display.flip()
        clock.tick(60)



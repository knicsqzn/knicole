# 8. PLAY LEVEL
# ==========================================

def play_level(level_name, screen):

    clock = pygame.time.Clock()

    title_font = pygame.font.SysFont("arial", 25, bold=True)
    question_font = pygame.font.SysFont("arial", 19, bold=True)
    choice_font = pygame.font.SysFont("arial", 16, bold=True)
    small_font = pygame.font.SysFont("arial", 18, bold=True)

    fonts = (
        title_font,
        question_font,
        choice_font,
        small_font
    )

    q_list = QUESTIONS[level_name].copy()
    random.shuffle(q_list)

    hearts = 3
    score = 0

    total_q = len(q_list)

    for i, q in enumerate(q_list, start=1):

        if hearts <= 0:
            break

        player_lane = 1
        obstacle_y = 230
        answered = False

        # QUESTION READING TIME

        read_time = READING_TIME

        while read_time > 0:

            for event in pygame.event.get():

                if event.type == pygame.QUIT:
                    pygame.quit()
                    sys.exit()

                if event.type == pygame.KEYDOWN:

                    if event.key == pygame.K_ESCAPE:
                        return False, score

            draw_game(
                screen, q, hearts, score,
                i, total_q, player_lane,
                obstacle_y, fonts,
                True, int(read_time) + 1
            )

            clock.tick(60)

            read_time -= 1 / 60

        # ANSWERING TIME

        while not answered:

            delta_time = clock.tick(60) / 1000

            for event in pygame.event.get():

                if event.type == pygame.QUIT:
                    pygame.quit()
                    sys.exit()

                if event.type == pygame.KEYDOWN:

                    if event.key == pygame.K_LEFT:
                        player_lane = max(0, player_lane - 1)

                    elif event.key == pygame.K_RIGHT:
                        player_lane = min(2, player_lane + 1)

                    elif event.key == pygame.K_ESCAPE:
                        return False, score

            obstacle_y += OBSTACLE_SPEED * delta_time

            draw_game(
                screen, q, hearts, score,
                i, total_q, player_lane,
                obstacle_y, fonts
            )

            # CHECK ANSWER

            if obstacle_y >= 465:

                chosen_answer = ["A", "B", "C"][player_lane]

                if chosen_answer == q["correct"]:

                    score += 1

                    show_message_box(
                        screen,
                        "CORRECT ANSWER!",
                        f"Great job! Your score is now {score}!",
                        GREEN
                    )

                else:

                    hearts -= 1

                    show_message_box(
                        screen,
                        "WRONG ANSWER!",
                        f"Correct answer: {q['correct']} | Hearts left: {hearts}",
                        RED
                    )

                answered = True

        if hearts <= 0:
            break

    if hearts <= 0:
        return False, score

    return True, score



def animate(index=0):
    if index >= len(target):
        welcome_label.config(text=target)
        root.after(1000, close_welcome)  # Waits 1 second, then closes Tkinter
        return

    if target[index] == " ":
        current[index] = " "
        animate(index + 1)
    else:
        letter = random.choice(letters)
        current[index] = letter
        welcome_label.config(text="".join(current))

        if letter == target[index]:
            root.after(5, animate, index + 1)
        else:
            root.after(5, animate, index)


